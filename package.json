{
  "name": "cs2-demo-analyst",
  "productName": "CS2 Demo Analyst",
  "version": "0.1.0",
  "description": "CS2 Demo Analyst — 挂接 CS2 播放进程的 Demo 分析师：语音转写、一键跳转、原生观战 HUD 风格",
  "main": "out/main/index.js",
  "private": true,
  "author": "cs2-demo-analyst",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "npm run web:dev",
    "web:dev": "vite --config vite.config.ts",
    "web:build": "vite build --config vite.config.ts",
    "web:preview": "vite preview --config vite.config.ts",
    "smoke": "electron-vite build && cross-env ELECTRON_SMOKE=1 electron out/main/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run dist:zip",
    "dist:zip": "electron-vite build && powershell -ExecutionPolicy Bypass -File scripts/make-zip.ps1",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@deademx/cs2": "^3.4.1",
    "@deademx/engine": "^3.4.1",
    "@eshaz/web-worker": "^1.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/chakra-petch": "^5.3.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.6"
  }
}
